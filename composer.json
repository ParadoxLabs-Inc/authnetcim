{
    "name": "paradoxlabs/authnetcim",
    "description": "Authorize.Net CIM payment method for Magento 2.x by Paradox Labs",
    "keywords": [
        "payment",
        "authorize.net",
        "tokenization"
    ],
    "require": {
        "php": ">=8.1",
        "paradoxlabs/tokenbase": "^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.0 || ^12.0",
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "type": "magento2-module",
    "version": "6.1.0",
    "time": "2026-09-15",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Ryan Hoerr",
            "email": "ryan@paradoxlabs.com"
        }
    ],
    "archive": {
        "exclude": [
            ".github",
            "README.md"
        ]
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "ParadoxLabs\\Authnetcim\\": ""
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
