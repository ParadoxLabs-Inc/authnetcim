<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Admin area, like core's MessageList messages: an area array argument replaces the global one, not merges. -->
    <type name="Magento\Framework\Notification\MessageList">
        <arguments>
            <argument name="messages" xsi:type="array">
                <item name="authnetcim_applepay_certificate_expiry" xsi:type="string">ParadoxLabs\Authnetcim\Model\Wallet\ApplePay\CertificateExpiryMessage</item>
            </argument>
        </arguments>
    </type>
</config>
